{
  "name": "personalized-ai-coach-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "concurrently -n web,api \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && go run ./cmd/api",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "cd backend && go build ./...",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "cd backend && go test ./...",
    "lint": "npm --prefix frontend run lint && cd backend && go vet ./...",
    "format": "prettier --write \"frontend/**/*.{ts,vue,json,css,md}\" \"api/**/*.{yaml,yml}\" \"docs/**/*.md\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
