# Application
APP_ENV=development
HTTP_ADDR=:8080

# Authentication: development tokens are allowed only when APP_ENV is development/local.
AUTH0_ISSUER=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=ai-learning-coach

# Primary OpenAI-compatible inference gateway
LLM_BASE_URL=http://localhost:8000
LLM_API_KEY=
LLM_PLANNING_MODEL=planning
LLM_TEACHING_MODEL=teaching
LLM_ASSESSMENT_MODEL=assessment
LLM_INTERVIEW_MODEL=interview

# Local infrastructure
DATABASE_URL=postgres://coach:coach_local_only@localhost:5432/coach?sslmode=disable
REDIS_URL=redis://localhost:6379/0
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
OBJECT_BUCKET=coach-documents
MINIO_ROOT_USER=coach
MINIO_ROOT_PASSWORD=coach_local_only

# Frontend
VITE_API_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_DEMO_MODE=false
